{
  "version": 4,
  "configurePresets": [
    {
      "name": "mdkXBLAS-gcc",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_C_FLAGS": "-O2 -Wall -Wextra -pedantic",
        "CMAKE_CXX_FLAGS": "-O2 -Wall -Wextra -pedantic",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -Wall -Wextra -pedantic",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -Wall -Wextra -pedantic",

        "MDKXBLAS_USE_FLOAT128": "OFF",
        "MDKXBLAS_USE_XERBLA": "OFF",
        "MDKXBLAS_NO_BLAS_MALLOC": "OFF",
        "MDKXBLAS_DEBUG_BLAS_MALLOC": "OFF"
      }
    }
  ]
}
